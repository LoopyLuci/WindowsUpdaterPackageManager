{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopyluci.github.io/WindowsUpdateAndPackageManager/schemas/index.schema.json",
  "title": "WUPM Repository Index",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": ["id", "version", "sha256", "created"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "installCommand": {
          "type": "string",
          "minLength": 1
        },
        "uninstallCommand": {
          "type": "string"
        },
        "supportsOffline": {
          "type": "boolean"
        },
        "requiresReboot": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deltaFrom": {
          "type": "string"
        },
        "artifactUrl": {
          "type": "string",
          "format": "uri"
        },
        "driverManifestUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    }
  }
}
