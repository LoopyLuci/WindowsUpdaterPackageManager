<UserControl x:Class="WupmGui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WupmGui.ViewModels">
  <DockPanel Margin="16">
    <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,12"/>
    <StackPanel>
      <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,0,0,6"/>
      <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup}" Margin="0,0,0,12"/>

      <TextBlock Text="Service" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Button Content="Install Windows Service" Command="{Binding InstallServiceCommand}" Margin="0,0,0,6"/>
      <Button Content="Uninstall Windows Service" Command="{Binding UninstallServiceCommand}" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding ServiceStatus}" Margin="0,0,0,12"/>

      <TextBlock Text="Telemetry" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <CheckBox Content="Send anonymous usage data" IsChecked="{Binding TelemetryEnabled}" Margin="0,0,0,12"/>

      <TextBlock Text="About" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Version}" Margin="0,0,0,6"/>
      <Button Content="Copy Diagnostics" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,0,6"/>
    </StackPanel>
  </DockPanel>
</UserControl>
